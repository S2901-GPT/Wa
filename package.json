{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "artifacts/api-server",
    "artifacts/qatar-obituary-form",
    "lib/api-client-react",
    "lib/api-zod",
    "lib/db"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build artifacts/qatar-obituary-form && node build-server.mjs",
    "gcp-build": "npm run build",
    "start": "if [ -f dist/server.mjs ]; then node --enable-source-maps dist/server.mjs; else tsx server.ts; fi",
    "typecheck": "tsc --build",
    "test": "cd artifacts/qatar-obituary-form && npm test && cd ../api-server && npm test",
    "lint": "tsc --build"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "@firebase/firestore": "4.17.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  },
  "overrides": {
    "rollup": "4.63.6"
  }
}
